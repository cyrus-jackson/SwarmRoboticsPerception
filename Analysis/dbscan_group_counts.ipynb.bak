   "source": [
    "summary = (runs.groupby([\"PerceptionValue\", \"MaxSpeed\"])\n",
    "                .agg(n=(\"file\", \"size\"),\n",
    "                     Groups_start=(\"GroupsStart\", \"mean\"),\n",
    "                     Groups_x1=(\"GroupsX1\", \"mean\"),\n",
    "                     Groups_x2=(\"GroupsX2\", \"mean\"),\n",
    "                     Groups_end=(\"GroupsEnd\", \"mean\"),\n",
    "                     reached_x1=(\"GroupsX1\", \"count\"),\n",
    "                     reached_x2=(\"GroupsX2\", \"count\"))\n",
    "                .round(2)\n",
    "                .reset_index())\n",
    "summary"
   ]
  },
